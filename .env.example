# Copy this file to .env and fill in real values locally.
# .env is git-ignored - never commit real secrets, tokens, logins, or IDs.

# --- Required: advisory / instrument configuration -------------------------
ADVISORY_LOGICAL_SYMBOL=BTC
ADVISORY_BINANCE_SYMBOL=BTCUSDT
ADVISORY_MT5_SYMBOL=BTCUSDt
ADVISORY_CONTRACT_TYPE=PERPETUAL
ADVISORY_MARKET=CRYPTO
MT5_ROLLOVER_TIMEZONE=Europe/Kyiv
CALENDAR_SERVER_TIMEZONE=Europe/Kyiv
CALENDAR_BRIDGE_PATH=./data/calendar_bridge.json

# --- Required: Telegram -----------------------------------------------------
# TELEGRAM_BOT_TOKEN: from @BotFather. Never commit the real value.
# TELEGRAM_ALLOWED_USER_IDS: comma-separated Telegram numeric user IDs
# authorized to use the bot (private chat only). Replace with your own ID(s).
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_ALLOWED_USER_IDS=123456789

# --- Optional: MT5 credentials ----------------------------------------------
# MT5_LOGIN / MT5_PASSWORD / MT5_SERVER are all-or-nothing: provide all three
# for explicit headless login, or leave all three empty to use whatever
# account the local MT5 terminal is already authenticated as (the preferred
# local setup - no credentials needed if you're already logged in). Providing
# only some of the three is a configuration error and will fail to start.
MT5_PATH=C:\Path\To\terminal64.exe
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# --- Optional: LLM explanation layer ----------------------------------------
# LLM is disabled by default - the system runs fully on the deterministic
# explanation fallback with no OpenAI key required. Set LLM_ENABLED=true and
# fill in OPENAI_API_KEY/OPENAI_MODEL to enable optional narrative
# explanations (OpenAI is NEVER consulted for the trading decision itself).
LLM_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT_SECONDS=30

# --- Optional: local persistence path overrides -----------------------------
# All four already have working defaults under ./data - only set these to
# relocate local storage.
ADVISORY_TRACKING_DIR=./data/tracking
ADVISORY_PROVENANCE_DIR=./data/provenance
ADVISORY_ROLLOVER_STATE_PATH=./data/rollover_state.json
ADVISORY_CYCLE_RECEIPT_DIR=./data/cycle_receipts
